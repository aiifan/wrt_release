# luci-app-xray（yichya 生态，轻量 xray 客户端，单节点场景替代 passwall/openclash）
# xray-core 由 openwrt-xray 提供（yichya 打包，随 Xray-core 官方源码编译）
CONFIG_PACKAGE_luci-app-xray=y
CONFIG_PACKAGE_luci-app-xray-status=y
CONFIG_PACKAGE_luci-app-xray-geodata=y
CONFIG_PACKAGE_openwrt-xray=y
# geodata：v2ray-geoip/geosite 装入 /usr/share/v2ray 并 symlink 到 /usr/share/xray，
# 其 PROVIDES @xray-geodata 满足 luci-app-xray-geodata 的依赖
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
