#!/bin/sh

# OpenList2 固化配置（uci-defaults，首次启动执行一次）
# 仅迁移数据目录：
# - data_dir（数据库/搜索索引）指向 eMMC 大分区，重刷固件不丢库
# - temp_dir（解压/打包中转工作区）随之指向外置分区，不落 tmpfs 避免吃内存
# 判断依据用块设备节点 /dev/mmcblk0p27（devtmpfs 早期就绪），
# 不用挂载点目录（uci-defaults 执行早于 fstab 挂载）；
# 分区方案不同的设备保持包默认目录。
# 服务自启/防火墙/延迟启动一律保持包默认（enabled='0'、allow_wan='0'），
# 验证通过后需要时再手动开启。

[ -f /etc/config/openlist2 ] || exit 0

if [ -b /dev/mmcblk0p27 ]; then
    uci -q set openlist2.@openlist2[0].data_dir='/mnt/mmcblk0p27/openlist2'
    uci -q set openlist2.@openlist2[0].temp_dir='/mnt/mmcblk0p27/openlist2/temp'
fi

uci -q commit openlist2

exit 0
